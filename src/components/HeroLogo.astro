<svg
  viewBox="0 0 320 320"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class="hero-logo"
>
  <circle cx="160" cy="160" r="160" fill="#C3E8BD" />
  <mask
    id="a"
    mask-type="alpha"
    maskUnits="userSpaceOnUse"
    x="66"
    y="66"
    width="230"
    height="230"
  >
    <circle cx="181" cy="181" r="115" fill="#222" />
  </mask>
  <g mask="url(#a)">
    <circle cx="181" cy="181" r="115" fill="#FF82A9" />
  </g>
</svg>

<style>
.hero-logo {
  max-width: 100%;
  width: 100%;
  height: 100%;
}

.hero-logo circle {
  transition: all 0.7s;
  transform-origin: 70% 70%;
  transform: scale(1);
}

.hero-logo mask circle {
  transition-delay: 0.3s;
}
</style> 